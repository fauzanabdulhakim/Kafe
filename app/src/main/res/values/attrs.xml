<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="LoopingViewPager">
        <attr name="isInfinite" format="boolean" />
        <attr name="autoScroll" format="boolean" />
        <attr name="scrollInterval" format="integer" />
        <attr name="viewpagerAspectRatio" format="float" />
    </declare-styleable>

    <declare-styleable name="ElegantNumberButton">
        <attr name="backGroundColor" format="color" />
        <attr name="textColor" format="color" />
        <attr name="textSize" format="dimension" />
        <attr name="initialNumber" format="integer" />
        <attr name="finalNumber" format="integer" />
    </declare-styleable>
</resources>
